# এই ফাইলটা GitHub-এ push করা safe — এখানে real key নেই, শুধু example।
# প্রজেক্ট clone করার পর এই ফাইলটা copy করে .env নামে save করো,
# তারপর নিজের real keys বসাও।

SECRET_KEY=your-django-secret-key-here

# Gemini API Key (Google AI Studio থেকে নাও)
GEMINI_API_KEY=your-gemini-api-key-here

# GitHub Personal Access Token
GITHUB_TOKEN=your-github-token-here

DEBUG=True
